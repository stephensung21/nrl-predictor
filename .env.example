# Copy to .env for running the pipeline locally. Every key is optional: a step whose key is missing
# is skipped. In GitHub Actions the same names are repository secrets (.github/workflows/pipeline-job.yml).

# The Odds API (pipeline/fetch_odds.py): Betr's opening prices for the coming games
ODDS_API_KEY=

# Supabase session pooler connection string (pipeline/publish.py, pipeline/backup.py)
SUPABASE_DB_URL=

# Claude writes the match previews and round recaps (pipeline/summaries.py)
ANTHROPIC_API_KEY=

# Encrypts the weekly tipping backup (pipeline/backup.py). Keep a copy somewhere else.
BACKUP_PASSPHRASE=

# Tells the website to refresh its cached pages after publishing (pipeline/publish.py)
REVALIDATE_URL=
REVALIDATE_SECRET=

# A throwaway Postgres for tests/test_publish.py (falls back to PGlite in web/ without it)
TEST_DATABASE_URL=
