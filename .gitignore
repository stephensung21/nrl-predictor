# Regenerable outputs: rebuilt by `python src/features.py`, `python src/train.py [--backtest]`
# and `python src/betting.py`. The scraped tables, odds sheet, params.json and Markdown reports
# stay committed.
data/processed/features.csv
data/processed/features_pre_kickoff.csv
reports/*.csv
reports/predictions/

# Pipeline replays of past seasons (pipeline/replay.py); live records in data/pipeline/live/ are committed
data/pipeline/replay/

# Encrypted tipping backups (pipeline/backup.py); kept as workflow artifacts, not in the repo
backups/

