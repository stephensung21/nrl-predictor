# Copy to .env.local. With nothing set, every page runs on the sample data in lib/sample*.ts.

# Supabase project (sign-in and tipping)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: deleting an account or removing a tipper. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Transaction pooler connection string for reading the model data (lib/db.ts)
SITE_DATABASE_URL=

# The trial site only (pipeline/trial.py): a banner, and the comp counting from the replayed 2026 rounds
NEXT_PUBLIC_TRIAL=
NEXT_PUBLIC_COMP_FIRST_SEASON=
